# Scratch notes never ship. .gitignore governs the repo; THIS file governs the
# VSIX — a private file must be excluded by both. (LICENSE has no .txt suffix in
# the source tree; vsce adds it when packaging, so it survives this rule.)
*.txt
fork-ref/**
dev-harness/**
.claude/**
tasks/**
# Tests never ship. Listed as a PATTERN, not one by one: the enumerated
# version silently shipped test-statusbar.js the first time a test file was
# added, because nobody remembers to update this list.
test-*.js
